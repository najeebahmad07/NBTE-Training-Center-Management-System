<?php
/**
 * RISE - Generate Certificate (Gated by Super Admin Approval)
 * ============================================================
 */

require_once 'includes/auth.php';
requireLogin();

if (!in_array($_SESSION['user_role'], ['admin', 'super_admin'])) {
    header('Location: dashboard.php');
    exit;
}

require_once 'includes/db.php';

$db         = getDB();
$student_id = (int) ($_GET['id'] ?? $_GET['student_id'] ?? 0);

if ($student_id <= 0) {
    setFlashMessage('error', 'Invalid student ID.');
    header('Location: students.php');
    exit;
}

// Fetch student
if ($_SESSION['user_role'] === 'super_admin') {
    $stmt = $db->prepare("
        SELECT s.*, p.program_name, p.duration, c.course_name, a.name as center_name
        FROM students s
        JOIN programs p ON s.program_id = p.id
        JOIN courses c ON s.course_id = c.id
        JOIN admins a ON s.admin_id = a.id
        WHERE s.id = :student_id
    ");
    $stmt->execute([':student_id' => $student_id]);
} else {
    $stmt = $db->prepare("
        SELECT s.*, p.program_name, p.duration, c.course_name
        FROM students s
        JOIN programs p ON s.program_id = p.id
        JOIN courses c ON s.course_id = c.id
        WHERE s.id = :student_id AND s.admin_id = :admin_id
    ");
    $stmt->execute([':student_id' => $student_id, ':admin_id' => $_SESSION['user_id']]);
}

$student = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$student) {
    setFlashMessage('error', 'Student not found or access denied.');
    header('Location: students.php');
    exit;
}

// Gate 1: Student must be approved by admin
if ($student['status'] !== 'Approved') {
    setFlashMessage('error', 'Certificate can only be generated for approved students.');
    header('Location: view_student.php?id=' . $student_id);
    exit;
}

// Gate 2: Certificate must be approved by Super Admin (skip this check for super_admin themselves)
if ($_SESSION['user_role'] !== 'super_admin') {
    if (($student['certificate_approved'] ?? 'Pending') !== 'Approved') {
        setFlashMessage('error', 'Certificate generation has not been approved by Super Admin yet. Please wait for approval.');
        header('Location: view_student.php?id=' . $student_id);
        exit;
    }
}

// Gate 3: Marks must be entered
$marks_check = $db->prepare("SELECT COUNT(*) FROM marks WHERE student_id = :student_id");
$marks_check->execute([':student_id' => $student_id]);
if ($marks_check->fetchColumn() == 0) {
    setFlashMessage('error', 'Marks must be entered before generating certificate.');
    header('Location: view_student.php?id=' . $student_id);
    exit;
}

// Calculate marks
$marks_stmt = $db->prepare("
    SELECT m.marks_obtained, sub.total_marks
    FROM marks m JOIN subjects sub ON m.subject_id = sub.id
    WHERE m.student_id = :student_id
");
$marks_stmt->execute([':student_id' => $student_id]);
$all_marks = $marks_stmt->fetchAll(PDO::FETCH_ASSOC);

$total_obtained = array_sum(array_column($all_marks, 'marks_obtained'));
$total_max      = array_sum(array_column($all_marks, 'total_marks'));
$percentage     = ($total_max > 0) ? round(($total_obtained / $total_max) * 100, 2) : 0;

if ($percentage >= 75)     { $grade = 'A'; $grade_text = 'First Division with Distinction'; }
elseif ($percentage >= 60) { $grade = 'B'; $grade_text = 'First Division'; }
elseif ($percentage >= 50) { $grade = 'C'; $grade_text = 'Second Division'; }
else                       { $grade = 'Fail'; $grade_text = 'Fail'; }

// Gate 4: Cannot generate for failed students
if ($grade === 'Fail') {
    setFlashMessage('error', 'Certificate cannot be generated for failed students.');
    header('Location: view_student.php?id=' . $student_id);
    exit;
}

// Certificate record — create if not exists
$cert_stmt = $db->prepare("SELECT * FROM certificates WHERE student_id = :student_id");
$cert_stmt->execute([':student_id' => $student_id]);
$certificate = $cert_stmt->fetch(PDO::FETCH_ASSOC);

if (!$certificate) {
    $cert_id = 'RISE-' . date('Y') . '-' . str_pad($student_id, 6, '0', STR_PAD_LEFT);
    $chk = $db->prepare("SELECT COUNT(*) FROM certificates WHERE certificate_id = :c");
    $chk->execute([':c' => $cert_id]);
    if ($chk->fetchColumn() > 0) $cert_id .= '-' . rand(100, 999);

    $ins = $db->prepare("INSERT INTO certificates (student_id, certificate_id, issue_date, created_at) VALUES (:s,:c,:d,NOW())");
    $ins->execute([':s' => $student_id, ':c' => $cert_id, ':d' => date('Y-m-d')]);
    $certificate = ['certificate_id' => $cert_id, 'issue_date' => date('Y-m-d')];
}

// ── Asset paths ───────────────────────────────────────────────────────────────
$student_photo_path = '';
if (!empty($student['photo'])) {
    $p = __DIR__ . '/uploads/photos/' . $student['photo'];
    if (file_exists($p)) $student_photo_path = $p;
}

$logo_path            = __DIR__ . '/assets/images/logo.jpg';
$has_logo             = file_exists($logo_path);
$signature_path       = __DIR__ . '/assets/images/authorized_signature.jpg';
$has_signature        = file_exists($signature_path);
$logos_path           = __DIR__ . '/assets/images/accreditation_logos.png';
$has_logos            = file_exists($logos_path);
$controller_sign_path = __DIR__ . '/assets/images/controller_signature.jpg';
$director_sign_path   = __DIR__ . '/assets/images/director_signature.jpg';
$has_director_sign    = file_exists($director_sign_path);
$seal_path            = __DIR__ . '/assets/images/seal.jpg';
$has_seal             = file_exists($seal_path);

$verify_base_url = 'https://yourdomain.com/verify_certificate.php';
$qr_data = $verify_base_url
         . '?cert_id='    . urlencode($certificate['certificate_id'])
         . '&enrollment=' . urlencode($student['enrollment_no']);

// ── TCPDF loader ──────────────────────────────────────────────────────────────
foreach (['vendor/tecnickcom/tcpdf/tcpdf.php','tcpdf/tcpdf.php','lib/tcpdf/tcpdf.php','TCPDF/tcpdf.php'] as $p) {
    if (file_exists($p)) { require_once $p; break; }
}
// ── TCPDF ─────────────────────────────────────────────────────────────────────
if (!class_exists('TCPDF')) {

    $paths = [
        __DIR__ . '/lib/TCPDF/tcpdf.php',   // correct server path
        __DIR__ . '/lib/tcpdf/tcpdf.php',
        __DIR__ . '/vendor/tecnickcom/tcpdf/tcpdf.php',
        __DIR__ . '/tcpdf/tcpdf.php'
    ];

    foreach ($paths as $p) {
        if (file_exists($p)) {
            require_once $p;
            break;
        }
    }

    if (!class_exists('TCPDF') && file_exists(__DIR__ . '/vendor/autoload.php')) {
        require_once __DIR__ . '/vendor/autoload.php';
    }
}

if (!class_exists('TCPDF')) {
    die('TCPDF not found.');
}

if (!class_exists('RISE_AuthCert_PDF')) {
    class RISE_AuthCert_PDF extends TCPDF {
        public function Header() {}
        public function Footer() {}
    }
}

class RISE_Certificate extends TCPDF {
    public function Header() {}
    public function Footer() {}
}



$pdf = new RISE_Certificate('L', 'mm', 'A4', true, 'UTF-8', false);
$pdf->SetCreator('RISE SaaS');
$pdf->SetAuthor('RISE');
$pdf->SetTitle('Certificate - ' . $student['full_name']);
$pdf->SetMargins(0, 0, 0);
$pdf->SetAutoPageBreak(false, 0);
$pdf->SetPrintHeader(false);
$pdf->SetPrintFooter(false);
$pdf->AddPage();

$W = 297; $H = 210;

// 1. White background
$pdf->SetFillColor(255, 255, 255);
$pdf->Rect(0, 0, $W, $H, 'F');

// 2. Navy border
$pdf->SetDrawColor(13, 54, 100);
$pdf->SetLineWidth(2.2);
$pdf->Rect(5, 5, $W - 10, $H - 10, 'D');

// 3. Navy header band
$hdr_h = 38;
$pdf->SetFillColor(13, 54, 100);
$pdf->Rect(5, 5, $W - 10, $hdr_h, 'F');

// Logo center
$logo_width = 24;
$logo_y     = 6;
list($orig_w, $orig_h) = getimagesize($logo_path);
$logo_height = ($orig_h / $orig_w) * $logo_width;
$logo_x = ($W - $logo_width) / 2;
if ($has_logo) {
    $pdf->Image($logo_path, $logo_x, $logo_y, $logo_width, 0, '', '', '', true, 300);
}

$pdf->SetFont('helvetica', '', 7);
$pdf->SetTextColor(175, 205, 240);
$pdf->SetXY(0, $logo_y + $logo_height);
$pdf->Cell($W, 4, 'Reliable Inclusive Skill Education', 0, 1, 'C');

$pdf->SetFont('helvetica', '', 6);
$pdf->SetTextColor(200, 222, 248);
$pdf->SetX(0);
$pdf->Cell($W, 4, 'RELIABLE INCLUSIVE SKILL EDUCATION An Autonomous Institute )', 0, 1, 'C');
$pdf->Cell($W, 4, '(An Autonomous Institution Registered Act of 2013 / Sec 18. Incorporated Under Ministry of Corporate Affairs, Government of India)', 0, 1, 'C');

$pdf->SetFont('helvetica', 'B', 8.5);
$pdf->SetTextColor(200, 222, 248);
$pdf->SetX(0);
$pdf->Cell($W, 4, 'C E R T I F I C A T E   O F   C O M P L E T I O N', 0, 0, 'C');

// 4. Body
$body_top = 47; $m = 14;

$pdf->SetFont('times', 'I', 11);
$pdf->SetTextColor(85, 95, 110);
$pdf->SetXY(0, $body_top);
$pdf->Cell($W, 6, 'This is to certify that', 0, 1, 'C');

$pdf->SetFont('times', 'B', 34);
$pdf->SetTextColor(13, 54, 100);
$pdf->SetXY(0, $body_top + 6);
$pdf->Cell($W, 15, htmlspecialchars($student['full_name']), 0, 1, 'C');

$nw  = min($pdf->GetStringWidth($student['full_name']), 170);
$nux = ($W - $nw) / 2;
$nuy = $body_top + 21.5;
$pdf->SetDrawColor(13, 54, 100);
$pdf->SetLineWidth(0.8);
$pdf->Line($nux, $nuy, $nux + $nw, $nuy);

$pdf->SetFont('helvetica', '', 8);
$pdf->SetTextColor(100, 112, 128);
$pdf->SetXY(0, $nuy + 2);
$pdf->Cell($W, 5, 'Enrollment No: ' . htmlspecialchars($student['enrollment_no']), 0, 1, 'C');

$pdf->SetFont('times', '', 11.5);
$pdf->SetTextColor(35, 42, 55);
$pdf->SetXY(0, $body_top + 31);
$pdf->Cell($W, 6, 'has successfully completed all requirements of the program', 0, 1, 'C');

$pb_w = 170; $pb_x = ($W - $pb_w) / 2; $pb_y = $body_top + 38; $pb_h = 13;
$pdf->SetFillColor(235, 243, 253);
$pdf->SetDrawColor(13, 54, 100);
$pdf->SetLineWidth(0.5);
$pdf->RoundedRect($pb_x, $pb_y, $pb_w, $pb_h, 2, '1111', 'DF');
$pdf->SetFillColor(13, 54, 100);
$pdf->Rect($pb_x, $pb_y, 3.5, $pb_h, 'F');
$pdf->SetFont('times', 'B', 15);
$pdf->SetTextColor(13, 54, 100);
$pdf->SetXY($pb_x, $pb_y + 2.5);
$pdf->Cell($pb_w, 8, htmlspecialchars($student['program_name']), 0, 0, 'C');

$pdf->SetFont('helvetica', '', 8);
$pdf->SetTextColor(65, 78, 95);
$pdf->SetXY(0, $pb_y + $pb_h + 3);
$pdf->Cell($W, 5, 'Course: ' . htmlspecialchars($student['course_name']) . '   |   Session: ' . htmlspecialchars($student['session_name']) . '   |   Batch: ' . htmlspecialchars($student['batch']), 0, 1, 'C');

$pl_w = 115; $pl_x = ($W - $pl_w) / 2; $pl_y = $pb_y + $pb_h + 9;
$pdf->SetFillColor(13, 54, 100);
$pdf->RoundedRect($pl_x, $pl_y, $pl_w, 9, 4.5, '1111', 'F');
$pdf->SetFont('helvetica', 'B', 8.5);
$pdf->SetTextColor(255, 255, 255);
$pdf->SetXY($pl_x, $pl_y + 1.8);
$pdf->Cell($pl_w, 6, 'Score: ' . $percentage . '%     Grade: ' . $grade . '     ' . $grade_text, 0, 0, 'C');

// Info grid
$grid_y = $pl_y + 13; $col1_x = $m + 4; $lbl_w = 38; $val_w = 55; $row_h = 8;
$fields = [
    ["Father's Name", $student['father_name'] ?? 'N/A'],
    ['Date of Birth',  !empty($student['dob']) ? date('d M Y', strtotime($student['dob'])) : 'N/A'],
    ['Duration',       ($student['duration'] ?? '') . ' Months'],
    ['Center Name',    'Reliable Inclusive Skill Education'],
];
foreach ($fields as $i => $field) {
    $row_y = $grid_y + $i * $row_h;
    if ($i % 2 === 0) { $pdf->SetFillColor(240, 246, 255); $pdf->Rect($col1_x, $row_y, $lbl_w + $val_w + 2, $row_h - 1, 'F'); }
    $pdf->SetFont('helvetica', 'B', 7.5); $pdf->SetTextColor(13, 54, 100);
    $pdf->SetXY($col1_x + 1, $row_y + 1.5); $pdf->Cell($lbl_w, 5, $field[0] . ':', 0, 0, 'L');
    $pdf->SetFont('helvetica', '', 7.5); $pdf->SetTextColor(35, 45, 60);
    $pdf->SetXY($col1_x + $lbl_w + 1, $row_y + 1.5); $pdf->Cell($val_w, 5, htmlspecialchars($field[1]), 0, 0, 'L');
    $pdf->SetDrawColor(210, 222, 238); $pdf->SetLineWidth(0.2);
    $pdf->Line($col1_x, $row_y + $row_h - 1, $col1_x + $lbl_w + $val_w + 2, $row_y + $row_h - 1);
}

// Student photo
$ph_w = 28; $ph_h = 34; $ph_x = $W - $m - $ph_w - 6; $ph_y = $body_top + 1;
$pdf->SetFillColor(13, 54, 100);
$pdf->Rect($ph_x - 1.5, $ph_y - 1.5, $ph_w + 3, $ph_h + 3, 'F');
if ($student_photo_path) {
    $pdf->Image($student_photo_path, $ph_x, $ph_y, $ph_w, $ph_h, '', '', '', true, 150);
} else {
    $pdf->SetFillColor(220, 232, 248);
    $pdf->Rect($ph_x, $ph_y, $ph_w, $ph_h, 'F');
    $pdf->SetFont('helvetica', '', 6); $pdf->SetTextColor(60, 90, 130);
    $pdf->SetXY($ph_x, $ph_y + $ph_h / 2 - 3);
    $pdf->Cell($ph_w, 6, 'PHOTO', 0, 0, 'C');
}
$pdf->SetFont('helvetica', '', 5.5); $pdf->SetTextColor(80, 92, 110);
$pdf->SetXY($ph_x - 1.5, $ph_y + $ph_h + 2);
$pdf->Cell($ph_w + 3, 4, htmlspecialchars($student['full_name']), 0, 0, 'C');

// 5. Signature section
$sep_y = $H - 36; $sig_y = $H - 20; $sig_lbl = $sig_y + 1.5; $sl = 52;
$pdf->SetDrawColor(185, 205, 228); $pdf->SetLineWidth(0.35);
$pdf->Line($m, $sep_y, $W - $m, $sep_y);
$pdf->SetFillColor(247, 250, 255);
$pdf->Rect($m, $sep_y, $W - $m * 2, $H - $sep_y - 6, 'F');

$s1x = $m + 8;
if (file_exists($controller_sign_path)) {
    $pdf->Image($controller_sign_path, $s1x + ($sl / 2) - 20, $sig_y - 16, 40, 14, '', '', '', true, 150, '', false, false, 0, 'CM');
}
$pdf->SetDrawColor(13, 54, 100); $pdf->SetLineWidth(0.5);
$pdf->Line($s1x, $sig_y, $s1x + $sl, $sig_y);
$pdf->SetFont('helvetica', 'B', 7); $pdf->SetTextColor(13, 54, 100);
$pdf->SetXY($s1x, $sig_lbl); $pdf->Cell($sl, 4, 'Controller of Examinations', 0, 0, 'C');

$pdf->SetFont('helvetica', 'B', 6.5); $pdf->SetTextColor(95, 112, 135);
$pdf->SetXY(0, $sep_y + 4);
$pdf->Cell($W, 4.5, 'CERTIFICATE ID: ' . htmlspecialchars($certificate['certificate_id']), 0, 1, 'C');
$pdf->SetFont('helvetica', '', 7); $pdf->SetTextColor(75, 90, 110);
$pdf->SetX(0);
$pdf->Cell($W, 4.5, 'Date of Issue: ' . date('d F Y', strtotime($certificate['issue_date'])), 0, 1, 'C');

$seal_size = 20; $sc_x = ($W / 2) - ($seal_size / 2); $sc_y = $sep_y + 1;
if ($has_seal) {
    $pdf->Image($seal_path, $sc_x, $sc_y, $seal_size, $seal_size, 'JPG', '', '', true, 150);
} else {
    $seal_fallback = __DIR__ . '/assets/images/authorized_signature.jpg';
    if (file_exists($seal_fallback)) {
        $pdf->Image($seal_fallback, $sc_x, $sc_y, $seal_size, $seal_size, 'JPG', '', '', true, 150);
    } else {
        $pdf->SetDrawColor(13, 54, 100); $pdf->SetLineWidth(0.5);
        $pdf->Circle($W / 2, $sep_y + 10, 8, 0, 360, 'D');
        $pdf->SetFont('helvetica', 'B', 4.5); $pdf->SetTextColor(13, 54, 100);
        $pdf->SetXY($W / 2 - 8, $sep_y + 7); $pdf->Cell(16, 3, 'OFFICIAL SEAL', 0, 0, 'C');
    }
}

$s2x = $W - $m - 8 - $sl;
if ($has_director_sign) {
    $pdf->Image($director_sign_path, $s2x + ($sl / 2) - 20, $sig_y - 16, 40, 14, 'JPG', '', '', true, 150, '', false, false, 0, 'CM');
} elseif ($has_signature) {
    $pdf->Image($signature_path, $s2x + ($sl / 2) - 20, $sig_y - 16, 40, 14, 'JPG', '', '', true, 150, '', false, false, 0, 'CM');
}
$pdf->SetDrawColor(13, 54, 100); $pdf->SetLineWidth(0.5);
$pdf->Line($s2x, $sig_y, $s2x + $sl, $sig_y);
$pdf->SetFont('helvetica', 'B', 7); $pdf->SetTextColor(13, 54, 100);
$pdf->SetXY($s2x, $sig_lbl); $pdf->Cell($sl, 4, 'Director', 0, 0, 'C');

// 6. QR Code
$qr_s = 25; $qr_x = $W - $m - $qr_s - 1; $qr_y = $sep_y + 2;
$pdf->SetFillColor(255, 255, 255); $pdf->SetDrawColor(13, 54, 100); $pdf->SetLineWidth(0.4);
$pdf->Rect($qr_x - 1, $qr_y - 1, $qr_s + 2, $qr_s + 2, 'DF');
$pdf->write2DBarcode($qr_data, 'QRCODE,H', $qr_x, $qr_y, $qr_s, $qr_s, ['border' => false, 'vpadding' => 0, 'hpadding' => 0, 'fgcolor' => [13, 54, 100], 'bgcolor' => [255, 255, 255]], 'N');
$pdf->SetFont('helvetica', '', 5); $pdf->SetTextColor(80, 95, 115);
$pdf->SetXY($qr_x - 1, $qr_y + $qr_s + 2);
$pdf->Cell($qr_s + 2, 3.5, 'Scan to Verify', 0, 0, 'C');

// 7. Accreditation logos
if ($has_logos) {
    $lg_w = 80; $lg_h = 8;
    $pdf->Image($logos_path, ($W - $lg_w) / 2, $H - 11, $lg_w, $lg_h, '', '', '', true, 150);
} else {
    $pdf->SetFont('helvetica', '', 5); $pdf->SetTextColor(150, 162, 178);
    $pdf->SetXY(0, $H - 10);
    $pdf->Cell($W, 4, 'ISO · NSDC · Skill India · MSME · NSC', 0, 0, 'C');
}

// 8. Save & Output
$pdf_filename = 'CERT_' . $student['enrollment_no'] . '_' . time() . '.pdf';
$pdf_dir      = __DIR__ . '/uploads/certificates/';
if (!is_dir($pdf_dir)) mkdir($pdf_dir, 0755, true);

$pdf->Output($pdf_dir . $pdf_filename, 'F');

$upd = $db->prepare("UPDATE students SET certificate_pdf = :pdf WHERE id = :id");
$upd->execute([':pdf' => $pdf_filename, ':id' => $student_id]);

$pdf->Output('RISE_Certificate_' . $student['enrollment_no'] . '.pdf', 'I');
exit;